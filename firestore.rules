rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@.]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "onlak2030@gmail.com" ||
        request.auth.token.email.lower() == "amoal2030@gmail.com" ||
        request.auth.uid == "AzxlMQTMEQRZsJf3LCUbTjuwFus2"
      );
    }

    function isSupervisorDoc(key) {
      return exists(/databases/$(database)/documents/supervisors/$(key));
    }

    function getSupervisorDoc(key) {
      return get(/databases/$(database)/documents/supervisors/$(key)).data;
    }

    function isSupervisorAdmin() {
      return isSignedIn() && (
        (isSupervisorDoc(request.auth.uid) && getSupervisorDoc(request.auth.uid).role == "admin") ||
        (request.auth.token.email != null && isSupervisorDoc(request.auth.token.email.lower()) && getSupervisorDoc(request.auth.token.email.lower()).role == "admin")
      );
    }

    function isSupervisorWithPermission(perm) {
      return isSignedIn() && (
        (isSupervisorDoc(request.auth.uid) && getSupervisorDoc(request.auth.uid).permissions[perm] == true) ||
        (request.auth.token.email != null && isSupervisorDoc(request.auth.token.email.lower()) && getSupervisorDoc(request.auth.token.email.lower()).permissions[perm] == true)
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isSupervisorAdmin();
    }

    function hasPermission(perm) {
      return isAdmin() || isSupervisorWithPermission(perm);
    }

    // Probe connection collection
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
    }

    // 1. Settings Collection
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId) && (hasPermission("settings") || isSuperAdmin());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // 2. Broadcasts (الإذاعات الصباحية)
    match /broadcasts/{broadcastId} {
      allow get: if isValidId(broadcastId);
      allow list: if true;
      allow create, update, delete: if isValidId(broadcastId) && (hasPermission("broadcasts") || isSuperAdmin());
    }

    // 3. Lectures (المحاضرات التوعوية)
    match /lectures/{lectureId} {
      allow get: if isValidId(lectureId);
      allow list: if true;
      allow create, update, delete: if isValidId(lectureId) && (hasPermission("lectures") || isSuperAdmin());
    }

    // 4. Interviews (المقابلات)
    match /interviews/{interviewId} {
      allow get: if isValidId(interviewId);
      allow list: if true;
      allow create, update, delete: if isValidId(interviewId) && (hasPermission("interviews") || isSuperAdmin());
    }

    // 5. Quizzes (اختبر مدى صحة عاداتك)
    match /quizzes/{quizId} {
      allow get: if isValidId(quizId);
      allow list: if true;
      allow create, update, delete: if isValidId(quizId) && (hasPermission("quizzes") || isSuperAdmin());
    }

    // 6. Quiz Responses (نتائج الاستبانات للزوار)
    match /quiz_responses/{responseId} {
      // Public visitors can submit quiz answers
      allow create: if isValidId(responseId) && 
        incoming().score is number && 
        incoming().totalQuestions is number;
      // Only authorized staff can view aggregated quiz metrics
      allow get: if isValidId(responseId) && (hasPermission("quizzes") || isSuperAdmin());
      allow list: if (hasPermission("quizzes") || isSuperAdmin());
      allow update: if false; // Immutable once submitted
      allow delete: if isValidId(responseId) && (hasPermission("quizzes") || isSuperAdmin());
    }

    // 7. Events (الأنشطة والفعاليات)
    match /events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;
      allow create, update, delete: if isValidId(eventId) && (hasPermission("events") || isSuperAdmin());
    }

    // 8. Registrations (التسجيل في الأنشطة)
    match /registrations/{registrationId} {
      allow get: if isValidId(registrationId);
      allow list: if true;
      allow create, update, delete: if isValidId(registrationId) && (hasPermission("registrations") || isSuperAdmin());
    }

    // 9. Supervisors and Permissions (إدارة المشرفين والصلاحيات)
    match /supervisors/{supervisorId} {
      allow get: if isSignedIn() && isValidId(supervisorId) && (
        isAdmin() || 
        supervisorId == request.auth.uid || 
        (request.auth.token.email != null && supervisorId == request.auth.token.email.lower())
      );
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(supervisorId) && isAdmin();
    }

    // 10. Inquiries (رسائل واستفسارات الزوار)
    match /inquiries/{inquiryId} {
      // Public visitors can submit contact inquiries
      allow create: if isValidId(inquiryId) && 
        incoming().name is string && 
        incoming().name.size() > 0 &&
        incoming().email is string &&
        incoming().message is string;
      allow get: if isValidId(inquiryId) && isAdmin();
      allow list: if isAdmin();
      allow update, delete: if isValidId(inquiryId) && isAdmin();
    }
  }
}
